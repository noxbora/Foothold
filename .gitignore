# ============================================================
#  .gitignore — what git must never look at
# ------------------------------------------------------------
#  Patterns keep matching untracked files out of ordinary adds.
#  Already tracked files remain tracked; forced adds can override this.
#  Review the staged diff before committing or publishing.
# ============================================================

# ── Obsidian ────────────────────────────────────────────────
# Per-machine state: open panes, window size, plugin caches.
# Changes every time the app is opened, means nothing to a reader.
.obsidian/
.trash/

# ── macOS clutter ───────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes

# ── iCloud placeholder files ────────────────────────────────
*.icloud

# ── Secrets: never commit these, wherever they are ──────────
# Useful guardrails, not a guarantee that all secrets are detected.
*.pem
*.key
*.ppk
*.ovpn
*.kdbx
*.p12
id_rsa*
id_ed25519*
.env
.envrc
.aws/

# ── Personal study material: not part of the shippable playbook ──
# A whole folder, not a list of filenames. The previous version named
# the files individually and stopped covering them the moment they moved.
DOJO/
# The current DOJO is a sibling of PLAYBOOK, outside this Git repository.
# This pattern only applies if a DOJO directory is created inside it.

# Python verification caches
__pycache__/
*.pyc
